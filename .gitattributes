*.parquet filter=lfs diff=lfs merge=lfs -text

# Dataset manifests are hashed byte-for-byte (dataset_hash uses file size,
# dataset_content_hash uses the bytes). Never let a checkout rewrite their line
# endings: a CRLF Windows checkout would otherwise produce different hashes for
# the same dataset than the Linux/cluster checkout it was committed from.
*.csv -text
datasets/** -text
tests/fixtures/** -text
